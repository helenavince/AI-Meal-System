# =========================================================
# AI-Powered Smart Mess System - Environment Configuration
# =========================================================
# In local development mode, if SUPABASE_URL and SUPABASE_KEY are empty,
# the backend automatically runs in Zero-Config Local Mode using SQLite (backend/smart_mess.db).
# To connect to production Supabase PostgreSQL:
# 1. Create a Supabase project at https://supabase.com
# 2. Run the SQL script found in `supabase_schema.sql` in Supabase SQL Editor.
# 3. Paste your project URL and service role / anon key below.

PORT=8000
HOST=127.0.0.1
DEBUG=True

# Supabase Credentials (Optional for local testing, required for Supabase cloud)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ML Model Configuration
SAFETY_BUFFER_DEFAULT=0.08
MIN_SAFETY_BUFFER=0.03
MAX_SAFETY_BUFFER=0.20
MODEL_PATH=backend/ml/demand_model.joblib
